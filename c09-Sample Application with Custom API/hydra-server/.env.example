# Application / API
APP_ID=hydra-server
PORT=3001
LOG_LEVEL=debug
REQUEST_LIMIT=100kb
SESSION_SECRET=mySecret
OPENAPI_SPEC=/api/v1/spec
OPENAPI_ENABLE_RESPONSE_VALIDATION=false
API_IDENTIFIER=http://api.localhost

# OIDC / Dex configuration
OIDC_ISSUER=http://127.0.0.1:5556/dex         # The OIDC provider discovery URL
OIDC_CLIENT_ID=example-app                     # Registered client ID in Dex
OIDC_CLIENT_SECRET=myClientSecret              # Client secret for client credentials or admin API
OIDC_REDIRECT_URI=http://localhost:32000/callback  # Redirect URI for your frontend
OIDC_AUDIENCE=http://api.localhost            # Optional, audience for your API
OIDC_SCOPE=openid profile email               # Standard OIDC scopes
